# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it is already listed in .gitignore.
# No real secret is included in this repository.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL recommended) --------------------------------
# Get this from https://neon.tech → your project → Connection string (pooled).
# If you leave this empty the app falls back to a local embedded database
# stored in ./.pglite so you can run it without installing PostgreSQL.
DATABASE_URL=

# --- Authentication --------------------------------------------------------
# Long random string used to sign admin session cookies.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# --- Site ------------------------------------------------------------------
# Full public URL, no trailing slash. Used for SEO, sitemap and OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI chatbot (English + Amharic) ---------------------------------------
# Google AI Studio key: https://aistudio.google.com/app/apikey
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# If AI_API_KEY is empty the chatbot still works, answering only from the
# knowledge base you manage in /admin/knowledge.

# --- Media storage ---------------------------------------------------------
# local | cloudinary | vercel-blob
# "local" writes to ./public/uploads and is for development only —
# serverless hosts like Vercel have a read-only filesystem.
STORAGE_PROVIDER=local

# Cloudinary (recommended for video)
CLOUDINARY_CLOUD_NAME=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# --- Email notifications for new inquiries (Resend) -----------------------
# https://resend.com/api-keys
EMAIL_API_KEY=
EMAIL_FROM=Efrata Alex Website <onboarding@resend.dev>
EMAIL_TO=ephratahh16@gmail.com

# --- Analytics (optional) --------------------------------------------------
# Set to "1" to enable the built-in privacy-friendly page-view counter.
NEXT_PUBLIC_ANALYTICS=1
